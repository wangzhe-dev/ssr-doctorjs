{
  "name": "ssr-doctor-monorepo",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "A comprehensive toolset for detecting and preventing SSR compatibility issues",
  "engines": {
    "node": ">=18.0.0",
    "pnpm": ">=8.0.0"
  },
  "scripts": {
    "build": "pnpm -r --filter='./packages/*' run build",
    "test": "pnpm -r run test",
    "lint": "pnpm -r run lint",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md}\"",
    "clean": "pnpm -r run clean && rm -rf node_modules",
    "release:dry": "semantic-release --dry-run",
    "release": "semantic-release"
  },
  "keywords": [
    "ssr",
    "nextjs",
    "react",
    "eslint",
    "cli",
    "monorepo"
  ],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^20.11.0",
    "@typescript-eslint/eslint-plugin": "^7.0.0",
    "@typescript-eslint/parser": "^7.0.0",
    "eslint": "^8.56.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-prettier": "^5.1.3",
    "prettier": "^3.2.4",
    "semantic-release": "^23.0.0",
    "semantic-release-npm-github-publish": "^1.6.1",
    "tsup": "^8.0.1",
    "typescript": "^5.3.3",
    "vitest": "^1.2.0"
  }
}
