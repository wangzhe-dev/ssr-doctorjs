{
  "name": "ssr-doctor-monorepo",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "A comprehensive toolset for detecting and preventing SSR compatibility issues in React and Next.js applications",
  "repository": {
    "type": "git",
    "url": "https://github.com/wangzhe-dev/ssr-doctorjs.git"
  },
  "bugs": {
    "url": "https://github.com/wangzhe-dev/ssr-doctorjs/issues"
  },
  "homepage": "https://github.com/wangzhe-dev/ssr-doctorjs#readme",
  "engines": {
    "node": ">=18.0.0",
    "pnpm": ">=8.0.0"
  },
  "scripts": {
    "build": "pnpm -r --filter='./packages/*' run build",
    "test": "pnpm -r run test",
    "lint": "pnpm -r run lint",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md}\"",
    "clean": "pnpm -r run clean && rm -rf node_modules",
    "prepare": "husky install",
    "check:names": "node scripts/check-npm-availability.js",
    "prerelease": "pnpm check:names",
    "release": "pnpm run release:eslint-plugin && pnpm run release:cli",
    "release:eslint-plugin": "cd packages/eslint-plugin-ssr-doctor && semantic-release",
    "release:cli": "cd packages/cli && semantic-release",
    "release:dry": "pnpm run release:dry:eslint-plugin && pnpm run release:dry:cli",
    "release:dry:eslint-plugin": "cd packages/eslint-plugin-ssr-doctor && semantic-release --dry-run",
    "release:dry:cli": "cd packages/cli && semantic-release --dry-run",
    "codemod": "ts-node scripts/codemods/run-all.ts",
    "codemod:dynamic": "ts-node scripts/codemods/ensure-dynamic-ssr-false.ts",
    "codemod:guards": "ts-node scripts/codemods/wrap-browser-api-guards.ts",
    "codemod:unstable": "ts-node scripts/codemods/render-unstable-to-effect.ts",
    "codemod:refs": "ts-node scripts/codemods/getElementById-to-ref.ts"
  },
  "keywords": [
    "ssr",
    "nextjs",
    "react",
    "eslint",
    "eslint-plugin",
    "cli",
    "hydration",
    "dynamic-import",
    "server-side-rendering",
    "next-dynamic",
    "browser-api",
    "monorepo",
    "typescript"
  ],
  "author": "SSR Doctor Contributors",
  "license": "MIT",
  "devDependencies": {
    "@commitlint/cli": "^18.6.0",
    "@commitlint/config-conventional": "^18.6.0",
    "@semantic-release/changelog": "^6.0.3",
    "@semantic-release/git": "^10.0.1",
    "@types/glob": "^8.1.0",
    "@types/node": "^20.11.0",
    "@typescript-eslint/eslint-plugin": "^7.0.0",
    "@typescript-eslint/parser": "^7.0.0",
    "eslint": "^8.56.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-prettier": "^5.1.3",
    "glob": "^10.3.10",
    "husky": "^9.0.10",
    "prettier": "^3.2.4",
    "semantic-release": "^23.0.0",
    "ts-morph": "^21.0.1",
    "ts-node": "^10.9.2",
    "tsup": "^8.0.1",
    "typescript": "^5.3.3",
    "vitest": "^1.2.0"
  }
}
