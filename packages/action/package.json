{
  "name": "@ssr-doctor/action",
  "version": "0.1.0",
  "description": "GitHub Action for detecting SSR compatibility issues in React and Next.js applications",
  "type": "module",
  "main": "./dist/index.js",
  "private": true,
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "clean": "rm -rf dist"
  },
  "keywords": [
    "github-action",
    "ssr",
    "react",
    "nextjs",
    "next",
    "server-side-rendering",
    "hydration",
    "ci",
    "actions"
  ],
  "author": "SSR Doctor Contributors",
  "license": "MIT",
  "engines": {
    "node": ">=18.0.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/wangzhe-dev/ssr-doctorjs.git",
    "directory": "packages/action"
  },
  "bugs": {
    "url": "https://github.com/wangzhe-dev/ssr-doctorjs/issues"
  },
  "homepage": "https://github.com/wangzhe-dev/ssr-doctorjs/tree/main/packages/action#readme",
  "dependencies": {
    "@actions/core": "^1.10.1",
    "@actions/exec": "^1.1.1",
    "@ssr-doctor/cli": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "tsup": "^8.0.1",
    "typescript": "^5.3.3"
  }
